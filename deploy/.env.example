# Darts – Einstellungen des Servers.
# Docker:       cp .env.example .env              (liegt neben docker-compose.yml)
# Ohne Docker:  cp .env.example /etc/darts/darts.env
# Zeilen mit # sind Kommentare.

# --- Nur für Docker mit mitgeliefertem Caddy (Profil "https") -------------------
# (Sub-)Domain, für die Caddy automatisch ein Let's-Encrypt-Zertifikat holt.
DOMAIN=darts.example.org

# Port auf dem Server, unter dem der Container lokal (127.0.0.1) erreichbar ist –
# nur wichtig, wenn ein eigener Reverse-Proxy davor sitzt und 8080 schon belegt ist.
DARTS_HOST_PORT=8080

# --- Server ----------------------------------------------------------------------
# Öffentliche Adresse, unter der die App erreichbar ist (mit https://, ohne / am Ende).
PUBLIC_URL=https://darts.example.org

# Port und Adresse, auf denen der Server lauscht.
# Ohne Docker hinter nginx/Caddy auf demselben Rechner: HOST=127.0.0.1 (von außen nicht erreichbar).
# (Im Docker-Container fest 8080 / 0.0.0.0 – hier ignoriert.)
PORT=8080
HOST=127.0.0.1

# Läuft der Server hinter einem Reverse-Proxy (nginx, Caddy, Cloudflare …)? Dann true, damit die
# echte Besucher-IP aus X-Forwarded-For genutzt wird (Rate-Limit, Sperre bei falschen Raum-Codes).
# Nur true, wenn der Server NICHT direkt aus dem Internet erreichbar ist (der Header ist sonst fälschbar).
# (Docker: fest true.)
TRUST_PROXY=true

# Räume ohne Aktivität werden nach so vielen Stunden gelöscht.
ROOM_TTL_HOURS=24

# Höchstzahl gleichzeitiger Räume (Schutz vor Überlastung).
MAX_ROOMS=500

# Höchstzahl Gäste je Raum (die App erlaubt höchstens 8).
MAX_PEERS_PER_ROOM=8

# Älteste Protokollversion, die angenommen wird. Ältere Apps bekommen „Bitte aktualisieren“.
MIN_PROTOCOL=3

# Log-Umfang: error, warn, info, debug. Spielernamen und Spielinhalte werden nie geloggt.
LOG_LEVEL=info

# --- Pfade (Standard passt für Docker und /opt/darts – normalerweise nicht ändern) ---
# WEB_DIR=./web
# APK_DIR=./apk
# VERSION_FILE=./version.json
